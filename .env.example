# --- AI provider (required) ---------------------------------------------
# Selects which Vercel AI SDK provider lib/ai/generate-resume-draft.ts uses.
# Supported values: "anthropic" | "openai" | "google" | "mistral" | "groq"
AI_PROVIDER=mistral
# Model id passed straight to the provider, e.g. "mistral-large-latest",
# "claude-sonnet-5" (Anthropic), "gpt-5" (OpenAI), "gemini-3-pro-preview".
#
# Extraction quality depends heavily on model strength: this task asks the
# model to fill a large, entirely-optional 13-section schema in one shot, and
# weaker models under-extract silently (dropping bullets, education, and
# skills that are plainly present in the source) — which Zod cannot catch,
# because a resume missing its education section is still schema-valid.
#
# Measured against fixtures/sample-resume.txt (see docs/architecture.md):
#   mistral-large-latest   14/14, 3/3 runs, ~7s   <- default
#   mistral-medium-latest  14/14, 3/3 runs, ~3-9s (cheaper, scored the same)
#   gemini-3-flash-preview inconsistent run to run
#   groq (any model)       cannot enforce this schema; see architecture notes
AI_MODEL=mistral-large-latest

# Only the key for the provider you selected above is required.
MISTRAL_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
GROQ_API_KEY=

# --- Database (Supabase Postgres) ----------------------------------------
# Required from Phase 3 on. Prisma connects with this over the pg driver
# adapter (Prisma 7 no longer takes a url in schema.prisma).
# Use Supabase's pooled "Transaction mode" string for the app at runtime.
# Serverless note: append ?pgbouncer=true&connection_limit=1 for the pooled
# URL. Migrations need the DIRECT (session-mode, port 5432) string instead.
DATABASE_URL=
# Optional: direct connection used only by `prisma migrate` (port 5432).
DIRECT_URL=

# --- Supabase Auth --------------------------------------------------------
# Both of these are public by design and ship to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Bypasses Row Level Security, so it must NEVER be prefixed
# with NEXT_PUBLIC_ or imported into a client component. Not required by the
# current code paths — every query runs through Prisma as the table owner —
# but documented here because Supabase admin operations need it.
SUPABASE_SERVICE_ROLE_KEY=

# --- Rate limiting (optional) ---------------------------------------------
# If both are set, /api/generate rate-limits per IP via Upstash Redis
# (@upstash/ratelimit). If either is missing, it silently falls back to an
# in-memory limiter — the app never crashes for lack of Redis.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
